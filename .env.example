# Copy to .env and fill in (file is gitignored)
CURSOR_API_KEY=cursor_your_key_here

# --- Manual Mac worker only (Docker agent uses compose env instead) ---
# REDIS_HOST=localhost
# EGIS_API_URL=http://localhost:8000

# Optional shared secret between worker and egis-app
# AGENT_INTERNAL_TOKEN=change-me-in-production

# Gray zone (egis-app reads these too if set in docker-compose)
# GRAY_ZONE_MIN=4
# GRAY_ZONE_MAX=7
# AGENT_ENABLED=true
# CURSOR_AGENT_MODEL=composer-2.5
